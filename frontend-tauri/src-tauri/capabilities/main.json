{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Fluxora main and settings webviews",
  "windows": [
    "main",
    "app-update",
    "settings",
    "build-settings:*",
    "mod-details:*",
    "text-editor:*",
    "file-preview:*"
  ],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:path:default",
    "core:resources:default"
  ]
}
