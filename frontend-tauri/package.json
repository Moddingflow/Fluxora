{
  "name": "fluxora-tauri",
  "version": "0.0.0",
  "description": "Fluxora Tauri UI shell",
  "private": true,
  "scripts": {
    "dev": "npm run stage:native && tauri dev",
    "dev:frontend": "vite --host 127.0.0.1",
    "start": "npm run dev",
    "typecheck": "tsc --noEmit",
    "build:frontend": "npm run typecheck && vite build",
    "stage:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-native-resources.ps1",
    "build": "npm run typecheck && npm run stage:native && tauri build",
    "package": "npm run build",
    "release:dry-run": "npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "test:ai-gate": "vitest run tests/ai-evaluation-suite.test.ts",
    "test:parity": "vitest run tests/parity-gate.test.ts",
    "parity:gate": "npm run typecheck && npm test && npm run test:e2e",
    "test:e2e": "npm run build:frontend && playwright test --pass-with-no-tests"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.9"
  }
}
