{
  "name": "fluxora-electron",
  "version": "0.0.0",
  "description": "Fluxora Electron UI shell",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-forge package",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release:dry-run": "npm run typecheck && npm test && npm run build && npm run make",
    "test": "vitest run",
    "test:parity": "vitest run tests/parity-gate.test.ts",
    "parity:gate": "npm run typecheck && npm test && npm run test:e2e",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.5.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@electron/get": "^5.0.0",
    "@electron/asar": "^4.2.0",
    "@electron/rebuild": "^4.0.4",
    "@inquirer/prompts": "^8.5.2",
    "esbuild": "^0.28.1",
    "get-package-info": "file:./vendor/get-package-info",
    "tar": "^7.5.16"
  }
}
