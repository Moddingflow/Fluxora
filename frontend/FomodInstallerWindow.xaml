<Window x:Class="Fluxora.App.FomodInstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Fluxora.App.Controls"
        xmlns:services="clr-namespace:Fluxora.App.Services"
        Title="FOMOD"
        Width="1000"
        Height="680"
        MinWidth="900"
        MinHeight="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource PanelBrush}"
        FontFamily="{StaticResource FluxoraFontBody}"
        FontWeight="Medium"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        FontSize="13"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Geometry x:Key="Icon.Check">M20 6 9 17l-5-5</Geometry>
        <Style x:Key="CaptionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <controls:LineIcon Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                               Width="15"
                                               Height="15"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"
                                               StrokeThickness="1.8" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerOverlayBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="116" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.46" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryDialogButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryDialogButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource LineHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Geometry x:Key="FluxoraScrollArrowUpGeometry">M 0 5 L 4 1 L 8 5 Z</Geometry>
        <Geometry x:Key="FluxoraScrollArrowDownGeometry">M 0 1 L 8 1 L 4 5 Z</Geometry>

        <Style x:Key="FluxoraVerticalScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bar"
                                    Background="{DynamicResource LineHoverBrush}"
                                    Width="7"
                                    MinHeight="34"
                                    Margin="0,1"
                                    CornerRadius="3.5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Stretch" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluxoraScrollLineButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Delay" Value="280" />
            <Setter Property="Interval" Value="45" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Arrow"
                                  Data="{TemplateBinding Content}"
                                  Width="8"
                                  Height="5"
                                  Fill="{DynamicResource MutedTextBrush}"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Arrow" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluxoraScrollPageButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="18" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{TemplateBinding Background}"
                              ClipToBounds="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12" />
                                <RowDefinition Height="3" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="3" />
                                <RowDefinition Height="12" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="7" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RepeatButton Grid.ColumnSpan="3"
                                          Style="{StaticResource FluxoraScrollLineButtonStyle}"
                                          Command="ScrollBar.LineUpCommand"
                                          Content="{StaticResource FluxoraScrollArrowUpGeometry}" />
                            <Track x:Name="PART_Track"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   Orientation="Vertical"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource FluxoraScrollPageButtonStyle}"
                                                  Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource FluxoraScrollPageButtonStyle}"
                                                  Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FluxoraVerticalScrollThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                            <RepeatButton Grid.Row="4"
                                          Grid.ColumnSpan="3"
                                          Style="{StaticResource FluxoraScrollLineButtonStyle}"
                                          Command="ScrollBar.LineDownCommand"
                                          Content="{StaticResource FluxoraScrollArrowDownGeometry}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepItemStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PanelHoverBrush}" />
                    <Setter Property="Opacity" Value="0.46" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FomodGroupCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource PanelSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsValidationTarget}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FomodVirtualListStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FomodVirtualListItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImagePreviewButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FomodOptionToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="-1"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="0"
                                                         Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource LineHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ToggleOnBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ToggleOnBorderBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding WasPreviouslySelected}" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding WasPreviouslySelected}" Value="True" />
                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ToggleOnBorderBrush}" />
                            </MultiDataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.56" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="DialogSurface"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="0"
                Opacity="0">
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="DialogSurface"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="24,18,18,14"
                      MouseLeftButtonDown="OnWindowDragMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="38"
                                Height="38"
                                CornerRadius="9"
                                Background="{DynamicResource AccentGradientBrush}"
                                Margin="0,0,12,0">
                            <controls:LineIcon Data="{StaticResource Icon.Layers}"
                                               Width="18"
                                               Height="18"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}" />
                        </Border>
                        <StackPanel MaxWidth="780">
                            <TextBlock Text="{Binding ModuleTitle}"
                                       FontSize="19"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ModuleSubtitle}"
                                       Margin="0,3,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource CloseCaptionButtonStyle}"
                            Tag="{StaticResource Icon.WindowClose}"
                            AutomationProperties.Name="Закрыть"
                            Click="OnCancelClick" />
                </Grid>

                <Grid Grid.Row="1"
                      Margin="24,0,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="206" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource PanelSoftBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top"
                                        Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Шаги"
                                               FontWeight="Black"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding StepCounterText}"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </Grid>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding NavigationSteps}"
                                              Margin="0,0,10,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StepItemStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="20"
                                                            Height="20"
                                                            BorderBrush="{DynamicResource LineHoverBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StepNumberText}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding StatusText}"
                                                                   Margin="0,4,0,0"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="12" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource SuccessSurfaceBrush}"
                                BorderBrush="{DynamicResource SuccessLineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,12"
                                Visibility="{Binding HasPreviousSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <controls:LineIcon Data="{StaticResource Icon.Refresh}"
                                                       Width="16"
                                                       Height="16"
                                                       Foreground="{DynamicResource SuccessBrush}"
                                                       Margin="0,0,9,0" />
                                    <TextBlock Text="{Binding PreviousSelectionText}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource SecondaryDialogButtonStyle}"
                                        Command="{Binding UsePreviousSelectionsCommand}"
                                        MinWidth="156"
                                        Margin="14,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:LineIcon Data="{StaticResource Icon.Refresh}"
                                                           Width="14"
                                                           Height="14"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                           Margin="0,0,8,0" />
                                        <TextBlock Text="Как в прошлый раз" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1"
                              DataContext="{Binding CurrentStep}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding Name}"
                                       FontSize="18"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,0,0,12"
                                       TextWrapping="Wrap" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="330" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="306" />
                                </Grid.ColumnDefinitions>

                                <ListBox x:Name="GroupItemsControl"
                                         Style="{StaticResource FomodVirtualListStyle}"
                                         ItemContainerStyle="{StaticResource FomodVirtualListItemStyle}"
                                         ItemsSource="{Binding Rows}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Border x:Name="GroupHeader"
                                                        Style="{StaticResource FomodGroupCardStyle}"
                                                        DataContext="{Binding Group}"
                                                        Visibility="Collapsed">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="Black"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding ValidationMessage}"
                                                                   Visibility="{Binding IsValidationTarget, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                   Foreground="{DynamicResource ErrorBrush}"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,8,0,0"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>

                                                <ToggleButton x:Name="OptionButton"
                                                              Style="{StaticResource FomodOptionToggleStyle}"
                                                              DataContext="{Binding Option}"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanToggle}"
                                                              MouseEnter="OnOptionPreview"
                                                              GotKeyboardFocus="OnOptionPreview"
                                                              Visibility="Collapsed">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border x:Name="OptionCheck"
                                                                Width="24"
                                                                Height="24"
                                                                CornerRadius="6"
                                                                Background="{DynamicResource PanelBrush}"
                                                                BorderBrush="{DynamicResource LineBrush}"
                                                                BorderThickness="1"
                                                                Margin="0,0,12,0"
                                                                VerticalAlignment="Center">
                                                            <controls:LineIcon x:Name="OptionGlyph"
                                                                               Data="{StaticResource Icon.Check}"
                                                                               Width="13"
                                                                               Height="13"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                               Visibility="Collapsed" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="Black"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding PreviousBadgeText}"
                                                                       Visibility="{Binding WasPreviouslySelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                       Foreground="{DynamicResource SuccessBrush}"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,7,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </ToggleButton>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                                                    <Setter TargetName="GroupHeader" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOption}" Value="True">
                                                    <Setter TargetName="OptionButton" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Option.IsSelected}" Value="True">
                                                    <Setter TargetName="OptionGlyph" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="OptionCheck" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="OptionCheck" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Grid.Column="2"
                                        Background="{DynamicResource PanelSoftBrush}"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        DataContext="{Binding DataContext.DetailsOption, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Button Style="{StaticResource ImagePreviewButtonStyle}"
                                                Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Click="OnPreviewImageClick"
                                                Margin="0,0,0,14"
                                                AutomationProperties.Name="Открыть изображение FOMOD">
                                            <Grid Height="170"
                                                  ClipToBounds="True">
                                                <Border CornerRadius="8"
                                                        Background="{DynamicResource PanelBrush}"
                                                        BorderBrush="{DynamicResource LineBrush}"
                                                        BorderThickness="1" />
                                                <Image services:FomodAsyncImage.SourcePath="{Binding PreviewImagePath}"
                                                       services:FomodAsyncImage.DecodePixelWidth="720"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Border CornerRadius="8"
                                                        Background="{DynamicResource PanelSoftBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="{x:Type Border}">
                                                            <Setter Property="Opacity" Value="0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True">
                                                                    <Setter Property="Opacity" Value="1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <controls:LineIcon Data="{StaticResource Icon.ImageExpand}"
                                                                       Width="34"
                                                                       Height="34"
                                                                       StrokeThickness="1.6"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" />
                                                </Border>
                                            </Grid>
                                        </Button>

                                        <ScrollViewer Grid.Row="1"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock Text="{Binding DisplayDescription}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="19" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2"
                      Margin="24,14,24,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="{DynamicResource ErrorBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryDialogButtonStyle}"
                                IsCancel="True"
                                Click="OnCancelClick"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <controls:LineIcon Data="{StaticResource Icon.Back}"
                                                   Width="14"
                                                   Height="14"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                   Margin="0,0,8,0" />
                                <TextBlock Text="Отмена" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryDialogButtonStyle}"
                                Command="{Binding PreviousStepCommand}"
                                Margin="0,0,10,0">
                            <TextBlock Text="Назад" />
                        </Button>
                        <Button Style="{StaticResource PrimaryDialogButtonStyle}"
                                IsDefault="True"
                                Click="OnPrimaryClick">
                            <StackPanel Orientation="Horizontal">
                                <controls:LineIcon Data="{StaticResource Icon.Plus}"
                                                   Width="14"
                                                   Height="14"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                   Margin="0,0,8,0" />
                                <TextBlock Text="{Binding PrimaryButtonText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="ImageLightboxOverlay"
              Visibility="Collapsed"
              Background="{DynamicResource PanelSoftBrush}"
              MouseLeftButtonDown="OnLightboxBackgroundMouseLeftButtonDown">
            <Image x:Name="LightboxImage"
                   services:FomodAsyncImage.SourcePath="{Binding PreviewImagePath}"
                   services:FomodAsyncImage.DecodePixelWidth="{Binding LightboxDecodePixelWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                   Stretch="Uniform"
                   Margin="42"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <Button x:Name="LightboxCloseButton"
                    Style="{StaticResource CloseCaptionButtonStyle}"
                    Tag="{StaticResource Icon.WindowClose}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="40"
                    Height="40"
                    Margin="0,22,22,0"
                    AutomationProperties.Name="Закрыть предпросмотр"
                    Click="OnLightboxCloseClick" />
        </Grid>
    </Grid>
</Window>
