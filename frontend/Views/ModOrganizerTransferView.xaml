<UserControl x:Class="Fluxora.App.Views.ModOrganizerTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FluxoraFontBody}"
             FontWeight="Medium"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.ClearTypeHint="Enabled"
             FontSize="12"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="PanelBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Effect" Value="{DynamicResource PanelShadow}" />
        </Style>

        <Style x:Key="InnerPanelStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="PillBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="9,5" />
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.46" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource LineHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepNavButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IncompleteStepCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="TransferTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.62" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransferComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource PanelSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="MaxDropDownHeight" Value="260" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="Padding" Value="9,7" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border x:Name="Root"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="Root"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                BorderThickness="1"
                                                CornerRadius="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="SelectedText"
                                                           Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE70D;"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource LineHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="{x:Null}">
                                                <Setter TargetName="SelectedText" Property="Text" Value="Выберите диск" />
                                                <Setter TargetName="SelectedText" Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{DynamicResource PanelSoftBrush}"
                                            BorderBrush="{DynamicResource LineHoverBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="4"
                                            Margin="0,4,0,0">
                                        <ScrollViewer CanContentScroll="True"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Style="{StaticResource PanelBorderStyle}"
                Padding="24">
            <Grid>
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTransferProcessVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding TransferStepTitle}"
                                   FontSize="31"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding TransferStepSubtitle}"
                                   Margin="0,7,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Style="{StaticResource PillBorderStyle}"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding TransferStepCounter}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,20,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource StepNavButtonStyle}"
                            Command="{Binding SelectTransferStepCommand}"
                            CommandParameter="0">
                        <Border>
                            <Border.Style>
                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource IncompleteStepCardStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTransferSourceComplete}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessLineBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTransferSourceStep}" Value="True">
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TransferSourceStepIcon}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTransferSourceComplete}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Источник"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TransferSourceStepStatus}"
                                               Margin="0,2,0,0"
                                               FontSize="10"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>

                    <Button Grid.Column="2"
                            Style="{StaticResource StepNavButtonStyle}"
                            Command="{Binding SelectTransferStepCommand}"
                            CommandParameter="1">
                        <Border>
                            <Border.Style>
                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource IncompleteStepCardStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTransferDestinationComplete}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessLineBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTransferDestinationStep}" Value="True">
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TransferDestinationStepIcon}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTransferDestinationComplete}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Назначение"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TransferDestinationStepStatus}"
                                               Margin="0,2,0,0"
                                               FontSize="10"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>

                    <Button Grid.Column="4"
                            Style="{StaticResource StepNavButtonStyle}"
                            Command="{Binding SelectTransferStepCommand}"
                            CommandParameter="2">
                        <Border>
                            <Border.Style>
                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource IncompleteStepCardStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTransferReviewComplete}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessLineBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTransferReviewStep}" Value="True">
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TransferReviewStepIcon}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTransferReviewComplete}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Проверка"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TransferReviewStepStatus}"
                                               Margin="0,2,0,0"
                                               FontSize="10"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid Visibility="{Binding IsTransferSourceStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Папка Mod Organizer 2"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource TransferTextBoxStyle}"
                                         Text="{Binding SourceDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding BrowseSourceCommand}"
                                        MinWidth="104">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE8B7;"
                                                   FontSize="13"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="Выбрать" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Style="{StaticResource InnerPanelStyle}"
                                    Padding="16"
                                    Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="Что будет перенесено"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="C++ core проверит структуру MO2, прочитает профиль, порядок модов и подготовит перенос без удаления исходной папки."
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding IsTransferDestinationStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding DestinationLabel}"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Style="{StaticResource TransferComboBoxStyle}"
                                      ItemsSource="{Binding AvailableDrives}"
                                      SelectedItem="{Binding SelectedDrive}"
                                      DisplayMemberPath="DisplayName"
                                      IsEnabled="{Binding CanChangeDestination}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource TransferTextBoxStyle}"
                                         Text="{Binding DestinationRootDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanChangeDestination}" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding BrowseDestinationCommand}"
                                        MinWidth="104"
                                        IsEnabled="{Binding CanChangeDestination}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE8B7;"
                                                   FontSize="13"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="Выбрать" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Style="{StaticResource InnerPanelStyle}"
                                    Padding="16"
                                    Margin="0,18,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Итоговая папка"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="{Binding TransferTargetText}"
                                                   Margin="0,8,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TransferAvailableText}"
                                               Margin="18,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Visibility="{Binding IsTransferReviewStep, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,4,0">
                        <StackPanel>
                            <Border Style="{StaticResource InnerPanelStyle}"
                                    Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding TransferProjectName}"
                                                       FontSize="22"
                                                       FontWeight="Black"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding TransferMessage}"
                                                       Margin="0,6,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <ProgressBar Grid.Row="1"
                                                 Height="3"
                                                 IsIndeterminate="True"
                                                 Foreground="{DynamicResource AccentHoverBrush}"
                                                 Background="{DynamicResource PanelSoftBrush}"
                                                 BorderThickness="0"
                                                 Margin="0,14,0,0"
                                                 Visibility="{Binding IsAnalyzingTransfer, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <Grid Grid.Row="2"
                                          Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource PanelRaisedBrush}"
                                                BorderBrush="{DynamicResource LineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Моды"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12" />
                                                <TextBlock Text="{Binding TransferModCountText}"
                                                           Margin="0,5,0,0"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2"
                                                Background="{DynamicResource PanelRaisedBrush}"
                                                BorderBrush="{DynamicResource LineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Вес"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12" />
                                                <TextBlock Text="{Binding TransferSizeText}"
                                                           Margin="0,5,0,0"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="Black" />
                                                <TextBlock Text="{Binding TransferAvailableText}"
                                                           Margin="0,3,0,0"
                                                           Foreground="{DynamicResource SubtleTextBrush}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="4"
                                                Background="{DynamicResource PanelRaisedBrush}"
                                                BorderBrush="{DynamicResource LineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Профиль"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12" />
                                                <TextBlock Text="{Binding TransferProfileText}"
                                                           Margin="0,5,0,0"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding TransferGameText}"
                                                           Margin="0,3,0,0"
                                                           Foreground="{DynamicResource SubtleTextBrush}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource WarningSurfaceBrush}"
                                    BorderBrush="{DynamicResource WarningLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,14,0,0"
                                    Visibility="{Binding HasTransferWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding TransferWarningText}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <Border Padding="12"
                                    Margin="0,14,0,0"
                                    Visibility="{Binding HasTransferAnalysis, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ErrorLineBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="CornerRadius" Value="10" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasEnoughSpace}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessLineBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding TransferDiskSpaceText}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="{Binding TransferTargetText}"
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="3"
                      Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource ErrorSurfaceBrush}"
                            BorderBrush="{DynamicResource ErrorLineBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,0,0,12"
                            Visibility="{Binding HasTransferError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding TransferError}"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelTransferFlowCommand}"
                                Content="Отменить перенос"
                                MinWidth="142" />

                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding PreviousTransferStepCommand}"
                                MinWidth="94">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE72B;"
                                           FontSize="12"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="Назад" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="4"
                                Command="{Binding NextTransferStepCommand}"
                                MinWidth="126">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTransferReviewStep}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding NextTransferStepText}" />
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE72A;"
                                           FontSize="12"
                                           Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="4"
                                Command="{Binding StartTransferCommand}"
                                MinWidth="164">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTransferReviewStep}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding StartTransferText}" />
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
