<UserControl x:Class="Fluxora.App.Views.LanguageSwitchSplash"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Fluxora.App.Services"
             IsHitTestVisible="{Binding IsLanguageSwitching}"
             FontFamily="{StaticResource FluxoraFontBody}"
             FontWeight="Medium"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.ClearTypeHint="Enabled"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <UserControl.Style>
        <Style TargetType="{x:Type UserControl}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLanguageSwitching}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Grid>
        <services:VisibleStoryboardService.Storyboard>
            <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="MainArcRotate"
                                         Storyboard.TargetProperty="Angle"
                                         From="-24"
                                         To="696"
                                         Duration="0:0:2.6" />
                        <DoubleAnimation Storyboard.TargetName="EchoArcRotate"
                                         Storyboard.TargetProperty="Angle"
                                         From="42"
                                         To="-678"
                                         Duration="0:0:2.6" />
                        <DoubleAnimation Storyboard.TargetName="CoreRotate"
                                         Storyboard.TargetProperty="Angle"
                                         From="0"
                                         To="360"
                                         Duration="0:0:2.6" />
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PulseLayer"
                                                       Storyboard.TargetProperty="Opacity">
                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.08" />
                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.24" KeySpline="0.2,0 0.16,1" />
                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0.08" KeySpline="0.28,0 0.16,1" />
                        </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </services:VisibleStoryboardService.Storyboard>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{DynamicResource ProcessBackdropStartColor}" Offset="0" />
                <GradientStop Color="{DynamicResource ProcessBackdropMidColor}" Offset="0.52" />
                <GradientStop Color="{DynamicResource ProcessBackdropEndColor}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Width="420"
              MaxWidth="420"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Width="112"
                  Height="112"
                  HorizontalAlignment="Center">
                <Ellipse Width="94"
                         Height="94"
                         Stroke="{DynamicResource SplashRingBrush}"
                         StrokeThickness="7"
                         Opacity="0.9" />

                <Ellipse x:Name="PulseLayer"
                         Width="72"
                         Height="72"
                         Fill="{DynamicResource SplashRingFillBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Opacity="0.08" />

                <Ellipse Width="94"
                         Height="94"
                         Stroke="{DynamicResource TextSecondaryBrush}"
                         StrokeThickness="7"
                         StrokeStartLineCap="Round"
                         StrokeEndLineCap="Round"
                         StrokeDashCap="Round"
                         StrokeDashArray="5.8 13.4"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="MainArcRotate" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse Width="62"
                         Height="62"
                         Stroke="{DynamicResource PrimaryForegroundBrush}"
                         StrokeThickness="4"
                         StrokeStartLineCap="Round"
                         StrokeEndLineCap="Round"
                         StrokeDashCap="Round"
                         StrokeDashArray="2 8.4"
                         Opacity="0.42"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="EchoArcRotate" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Border Width="27"
                        Height="27"
                        CornerRadius="14"
                        Background="{DynamicResource SplashCoreBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <RotateTransform x:Name="CoreRotate" />
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <TextBlock Grid.Row="2"
                       Text="{Binding LanguageSwitchTitle}"
                       FontSize="28"
                       FontWeight="Black"
                       Foreground="{DynamicResource SplashTextBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="4"
                       Text="{Binding LanguageSwitchSubtitle}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SplashSecondaryTextBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="400" />
        </Grid>

        <Border Height="1"
                VerticalAlignment="Top"
                Background="{DynamicResource PanelHoverBrush}"
                Opacity="0.36" />
    </Grid>
</UserControl>
