<UserControl x:Class="Fluxora.App.Views.FluxPackInstallProcessSplash"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Fluxora.App.Services"
             IsHitTestVisible="{Binding IsVisible}"
             FontFamily="{StaticResource FluxoraFontBody}"
             FontWeight="Medium"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.ClearTypeHint="Enabled"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="InstallProgressBarStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="9" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Foreground" Value="{DynamicResource InstallProgressBrush}" />
            <Setter Property="Background" Value="{DynamicResource InstallTrackBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid Height="{TemplateBinding Height}" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5" />
                            <Decorator x:Name="PART_Indicator"
                                       HorizontalAlignment="Left"
                                       ClipToBounds="True">
                                <Border Background="{TemplateBinding Foreground}"
                                        CornerRadius="5" />
                            </Decorator>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProviderAccentBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource ProviderDefaultBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProviderId}" Value="nexus">
                    <Setter Property="Background" Value="{DynamicResource ProviderNexusBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="github">
                    <Setter Property="Background" Value="{DynamicResource ProviderGitHubBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="mega">
                    <Setter Property="Background" Value="{DynamicResource ProviderMegaBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="modernflow">
                    <Setter Property="Background" Value="{DynamicResource ProviderModernFlowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="direct">
                    <Setter Property="Background" Value="{DynamicResource ProviderDirectBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProviderAccentForegroundTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource ProviderDefaultForegroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProviderId}" Value="nexus">
                    <Setter Property="Foreground" Value="{DynamicResource ProviderNexusForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="github">
                    <Setter Property="Foreground" Value="{DynamicResource ProviderGitHubForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="mega">
                    <Setter Property="Foreground" Value="{DynamicResource ProviderMegaForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="modernflow">
                    <Setter Property="Foreground" Value="{DynamicResource ProviderModernFlowForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="direct">
                    <Setter Property="Foreground" Value="{DynamicResource ProviderDirectForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProviderAccentTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource ProviderDefaultBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProviderId}" Value="nexus">
                    <Setter Property="Foreground" Value="{DynamicResource ProviderNexusBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="github">
                    <Setter Property="Foreground" Value="{DynamicResource ProviderGitHubBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="mega">
                    <Setter Property="Foreground" Value="{DynamicResource ProviderMegaBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="modernflow">
                    <Setter Property="Foreground" Value="{DynamicResource ProviderModernFlowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="direct">
                    <Setter Property="Foreground" Value="{DynamicResource ProviderDirectBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProviderInstallProgressBarStyle"
               TargetType="{x:Type ProgressBar}"
               BasedOn="{StaticResource InstallProgressBarStyle}">
            <Setter Property="Foreground" Value="{DynamicResource ProviderDefaultBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProviderId}" Value="nexus">
                    <Setter Property="Foreground" Value="{DynamicResource ProviderNexusBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="github">
                    <Setter Property="Foreground" Value="{DynamicResource ProviderGitHubBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="mega">
                    <Setter Property="Foreground" Value="{DynamicResource ProviderMegaBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="modernflow">
                    <Setter Property="Foreground" Value="{DynamicResource ProviderModernFlowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="direct">
                    <Setter Property="Foreground" Value="{DynamicResource ProviderDirectBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InstallCloseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource InstallSecondaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{DynamicResource InstallButtonBrush}"
                                BorderBrush="{DynamicResource InstallBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource InstallButtonHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource InstallSuccessBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InstallTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.Style>
        <Style TargetType="{x:Type UserControl}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Grid>
        <services:VisibleStoryboardService.Storyboard>
            <Storyboard RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="InstallSpinnerPath"
                                 Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                 From="0"
                                 To="360"
                                 Duration="0:0:2.4" />
            </Storyboard>
        </services:VisibleStoryboardService.Storyboard>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{DynamicResource InstallBackdropStartColor}" Offset="0" />
                <GradientStop Color="{DynamicResource InstallBackdropMidColor}" Offset="0.55" />
                <GradientStop Color="{DynamicResource InstallBackdropEndColor}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="660"
                MaxWidth="660"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="28"
                Padding="26"
                Background="{DynamicResource InstallPanelBrush}"
                BorderBrush="{DynamicResource InstallBorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource PanelShadowColor}"
                                  BlurRadius="34"
                                  ShadowDepth="14"
                                  Opacity="0.45" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="62"
                          Height="62"
                          Margin="0,0,18,0">
                        <Ellipse Stroke="{DynamicResource InstallRingBrush}"
                                 StrokeThickness="2"
                                 Fill="{DynamicResource InstallRingFillBrush}" />
                        <Path x:Name="InstallSpinnerPath"
                              Data="M 31,6 A 25,25 0 1 1 30.9,6"
                              Stroke="{DynamicResource InstallProgressBrush}"
                              StrokeThickness="3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Fill="{x:Null}"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform />
                            </Path.RenderTransform>
                        </Path>
                        <TextBlock Text="FP"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource InstallTextBrush}" />
                    </Grid>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentStep}"
                                   FontSize="24"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource InstallTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusText}"
                                   Margin="0,6,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource InstallSecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CurrentItem}"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource InstallMutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <ProgressBar Grid.Row="1"
                             Margin="0,24,0,8"
                             Style="{StaticResource InstallProgressBarStyle}"
                             services:ProgressAnimationService.IsActive="{Binding IsRunning}"
                             Value="{Binding OverallPercent, Mode=OneWay}" />

                <Grid Grid.Row="2"
                      Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SourceSummaryText}"
                               FontSize="12"
                               Foreground="{DynamicResource InstallMutedTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding OverallPercent, StringFormat={}{0}%}"
                               Margin="16,0,0,0"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource InstallTextBrush}" />
                </Grid>

                <ScrollViewer Grid.Row="3"
                              MaxHeight="260"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="12"
                                        Background="{DynamicResource InstallPanelSoftBrush}"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="38"
                                                Height="38"
                                                CornerRadius="19"
                                                Style="{StaticResource ProviderAccentBorderStyle}"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding IconText}"
                                                       Style="{StaticResource ProviderAccentForegroundTextStyle}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="Black" />
                                        </Border>

                                        <Grid Grid.Column="1"
                                              Margin="12,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource InstallTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CountText}"
                                                       Margin="14,0,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource InstallMutedTextBrush}" />

                                             <ProgressBar Grid.Row="1"
                                                          Grid.ColumnSpan="2"
                                                          Margin="0,10,0,7"
                                                          Style="{StaticResource ProviderInstallProgressBarStyle}"
                                                          Value="{Binding ProgressPercent, Mode=OneWay}" />

                                            <Grid Grid.Row="2"
                                                  Grid.ColumnSpan="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding CurrentItem}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource InstallSecondaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                 <TextBlock Grid.Column="1"
                                                            Text="{Binding StatusText}"
                                                            Style="{StaticResource ProviderAccentTextStyle}"
                                                            Margin="14,0,0,0"
                                                            FontSize="12"
                                                            FontWeight="Bold" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="4"
                      Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ResultText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource InstallSuccessBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource InstallErrorBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource InstallCloseButtonStyle}"
                            Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=CloseCommand}"
                            IsEnabled="{Binding CanClose}"
                            Content="Закрыть" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
